<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online music (D-34, D-38): catalogue requests and artwork, https only (NetworkPolicy and the
         platform's cleartext switch agree since the user-server sources were retired). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Buxes's own updates (D-99): the app tells of a new release and opens its page; installing is
         left to the browser. REQUEST_INSTALL_PACKAGES is deliberately not asked for: Play Protect in
         some regions (Indonesia among them) blocks sideloaded apps that hold it outright. -->

    <!-- Remote playback (YOUTUBE_MUSIC_ARCHITECTURE §8): Buxes needs to see whether the app that
         plays online songs is installed, and to open it on a song. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:name=".BuxesApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Buxes"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buxes">

        <!-- Portrait only (D-108): Buxes is a device you hold upright in one hand, and it has no
             landscape arrangement to turn into. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signing in on the online service's own page (§6); never started from outside Buxes.
             Turning, folding or resizing the phone keeps the page (and anything typed into it). -->
        <activity
            android:name=".WebSignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- What Android's installer says about an update (D-99); only the installer's own intent reaches it. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
